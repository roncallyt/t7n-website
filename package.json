{
  "name": "t7n-website",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@10.25.0",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "prepare": "husky",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "nuxt typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:nuxt": "vitest run --project nuxt",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@nuxt/content": "3.16.0",
    "@nuxt/fonts": "0.14.0",
    "@nuxt/icon": "2.5.1",
    "@nuxtjs/color-mode": "4.0.0",
    "@nuxtjs/i18n": "10.6.0",
    "@nuxtjs/seo": "5.3.14",
    "@pinia/nuxt": "0.11.3",
    "better-sqlite3": "^12.10.0",
    "ioredis": "5.11.1",
    "nuxt": "^4.5.2",
    "nuxt-listmonk": "3.1.0",
    "nuxt-maintainer": "1.1.0",
    "pinia": "^3.0.4",
    "valibot": "1.4.2",
    "vue": "^3.5.42",
    "vue-router": "^5.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@nuxt/eslint": "1.17.0",
    "@nuxt/test-utils": "4.0.3",
    "@nuxtjs/tailwindcss": "7.0.0-beta.1",
    "@playwright/test": "^1.60.0",
    "@vitest/coverage-v8": "^4.1.6",
    "@vue/test-utils": "^2.4.10",
    "@vueuse/core": "^14.3.0",
    "@vueuse/nuxt": "^14.3.0",
    "eslint": "10.10.0",
    "happy-dom": "^20.14.0",
    "husky": "9.1.7",
    "playwright-core": "^1.60.0",
    "tailwindcss": "^4.3.3",
    "typescript": "6.0.3",
    "vitest": "^4.1.6",
    "vue-tsc": "3.3.11"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3"
    ]
  }
